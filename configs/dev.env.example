# Copy this file to .env.dev and keep the resulting file outside Git.
APP_NAME=migtorg-chatbot
APP_ENVIRONMENT=development
DEPLOY_VERSION=dev-local
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=migtorg_chatbot_dev.sqlite3

KNOWLEDGE_V2_ENABLED=true
KNOWLEDGE_V2_SHADOW_MODE=false

# Dev must start with the external LLM enabled.
LLM_ENABLED=true
LLM_PROVIDER=qwen
LLM_ENVIRONMENT=dev
LLM_PRIMARY_MODEL=qwen-plus
LLM_FALLBACK_MODEL=qwen-flash
LLM_REASONING_EFFORT=none
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=300
LLM_MAX_CONCURRENCY=8
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
LLM_DEV_BUDGET_USD=1.0
LLM_PRODUCTION_BUDGET_USD=25.0
LLM_DAILY_BUDGET_USD=1.0
LLM_BUDGET_WARNING_PCT=80
# Fill from the provider's current tariff before enabling LLM.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

# Replace the URL with the OpenAI-compatible endpoint of the dev workspace.
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Set only in .env.dev or GitLab CI/CD Variables. Never commit the real key.
QWEN_API_KEY=

SEMANTIC_MODEL_ALLOW_DOWNLOAD=true
SEMANTIC_DENSE_ENABLED=true
SEMANTIC_CACHE_DIR=

LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

QUALITY_REPORT_TOKEN=

# Keep disabled until a separate dev support mailbox is configured.
TICKET_EMAIL_ENABLED=false
TICKET_EMAIL_TO=
TICKET_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TRUSTED_CONTEXT_SECRET=
TRUSTED_CONTEXT_ISSUER=migtorg-site
INTERNAL_STATUS_API_ENABLED=false
INTERNAL_STATUS_API_URL=
INTERNAL_STATUS_TIMEOUT_SECONDS=5
