APP_NAME=migtorg-chatbot
APP_ENVIRONMENT=development
DEPLOY_VERSION=local
DEBUG=true
CORS_ALLOWED_ORIGINS=*
DATABASE_PATH=migtorg_chatbot.sqlite3

LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_ENVIRONMENT=dev
LLM_PRIMARY_MODEL=openai/gpt-5.6-luna
LLM_FALLBACK_MODEL=openai/gpt-5.6-terra
LLM_REASONING_EFFORT=none
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=300
LLM_MAX_CONCURRENCY=8
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
LLM_DEV_BUDGET_USD=1.0
LLM_PRODUCTION_BUDGET_USD=25.0
LLM_DAILY_BUDGET_USD=5.0
LLM_BUDGET_WARNING_PCT=80
LLM_ROLLOUT_PERCENTAGE=0
# Set current provider prices; required when LLM_ENABLED=true.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

LITELLM_PROXY_URL=
LITELLM_API_KEY=

# Direct Alibaba Cloud Model Studio (Qwen), OpenAI-compatible API.
# Keep QWEN_API_KEY only in the backend environment; never commit it.
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# Set false in network-isolated production after the model has been preloaded.
SEMANTIC_MODEL_ALLOW_DOWNLOAD=true
SEMANTIC_DENSE_ENABLED=true
# Optional persistent directory for precomputed article embeddings.
SEMANTIC_CACHE_DIR=

LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Internal aggregated quality report. Keep this value backend-only.
QUALITY_REPORT_TOKEN=

TICKET_EMAIL_ENABLED=false
TICKET_EMAIL_TO=support@migtorg.example
TICKET_EMAIL_FROM=bot@migtorg.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Scenario engine and trusted personalized status lookups
KNOWLEDGE_V2_ENABLED=true
KNOWLEDGE_V2_SHADOW_MODE=false
TRUSTED_CONTEXT_SECRET=
TRUSTED_CONTEXT_ISSUER=migtorg-site
INTERNAL_STATUS_API_ENABLED=false
INTERNAL_STATUS_API_URL=
INTERNAL_STATUS_TIMEOUT_SECONDS=5
# Architecture experiment: wording LLM stays off independently of selection.
ROUTING_ARCHITECTURE=control
DIALOGUE_STATE_ENABLED=false
ARCHITECTURE_EXPERIMENT=true
LLM_UNDERSTANDING_ENABLED=false
